# FlowCore — environment variables
#
# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets. Loaded automatically via python-dotenv at
# process startup (see flowcore.py).

# ── Ollama (runtime/ollama.py) ────────────────────────────────────────────
# Override auto-discovery of the Ollama endpoint/model. Usually not needed —
# discover_ollama_endpoint()/discover_default_model() find these on their own
# (WSL2→Windows, Termux/LAN, ...). Set only if auto-discovery picks the wrong
# one.
# FLOWCORE_OLLAMA=http://127.0.0.1:11434
# FLOWCORE_MODEL=qwen2.5:7b
# FLOWCORE_OLLAMA_TIMEOUT=180

# ── Obsidian sync (flowcore.py obsidian) ──────────────────────────────────
# FLOWCORE_OBSIDIAN=/path/to/your/obsidian/vault

# ── Outlook (runtime/outlook.py, Sprint 17 Milestone 2) ───────────────────
# Requires an Azure AD app registration (public client, Device Code Flow —
# no redirect URI needed), with the Mail.Read delegated permission.
# OUTLOOK_CLIENT_ID=
# OUTLOOK_TENANT_ID=common
