<network-security-config>
    <!--
        FlowCore is local-first and the default API is HTTP on port 8080.
        Keep this for Termux/emulator/LAN development; use HTTPS before
        exposing the app beyond a trusted local network.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
